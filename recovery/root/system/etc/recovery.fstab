system                                     		/system                ext4                ro wait,slotselect,logical
system_ext                                     		/system_ext                ext4                ro wait,slotselect,logical
vendor                                     		/vendor                ext4                ro wait,slotselect,logical
product                                    		/product               ext4                ro wait,slotselect,logical

/dev/block/by-name/userdata              /data               f2fs    noatime,nosuid,nodev,discard,inline_xattr,inline_data latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable
/dev/block/platform/bootdevice/by-name/para /misc emmc defaults defaults
/dev/block/platform/bootdevice/by-name/boot /boot emmc defaults first_stage_mount,nofail,slotselect
